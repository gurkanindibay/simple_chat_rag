# Copy to .env and set the following
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
PDF_PATH=./citus-doc-readthedocs-io-en-latest.pdf
PORT=8000
# Embedding provider: OPENAI, LOCAL, or AZURE_OPENAI
EMBEDDING_PROVIDER=OPENAI
# LLM provider: OPENAI, LOCAL, AZURE_OPENAI, or LLAMA
LLM_PROVIDER=OPENAI
# If EMBEDDING_PROVIDER=LOCAL, set a HF model id (example: sentence-transformers/all-MiniLM-L6-v2)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_URL=postgresql://user:password@localhost:5432/yourdb
# Table name to store vectors (pgvector)
PGVECTOR_TABLE=documents_vectors

# Azure OpenAI Configuration (when using AZURE_OPENAI provider)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Microsoft Entra (Azure AD) Authentication
# Get these values from Azure Portal > App Registrations
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret  # Optional, for backend-only flows
